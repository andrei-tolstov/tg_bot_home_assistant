# Telegram Bot Токен, полученный от @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# ID пользователя Telegram, которому разрешено пользоваться ботом (важно для безопасности!)
# Можно узнать у бота @userinfobot
ALLOWED_USER_ID="123456789"

# URL вашего Home Assistant (без слеша на конце)
# Например: http://192.168.1.100:8123 или https://ha.mydomain.com
HA_URL="http://homeassistant.local:8123"

# Долгоживущий токен доступа (Long-Lived Access Token) из профиля пользователя в Home Assistant
HA_TOKEN="your_long_lived_access_token_here"

# Опционально: отправка уведомления в Telegram при старте бота (true по умолчанию).
# Полезно для фиксации момента включения электричества дома.
NOTIFY_ON_STARTUP=true
